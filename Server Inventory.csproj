<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Server_Inventory</RootNamespace>
    <AssemblyName>ServerInventory</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ServerInventory.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Server Inventory.Tests/**/*.cs" />
    <Content Remove="Server Inventory.Tests/**" />
    <None Remove="Server Inventory.Tests/**" />
  </ItemGroup>

</Project>
