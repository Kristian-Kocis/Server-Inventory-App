{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "ServerInventory": "Data Source=server-inventory.db"
  },
  "Jwt": {
    "Issuer": "ServerInventory",
    "Audience": "ServerInventory.Api",
    "AccessTokenMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
